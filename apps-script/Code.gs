const COLORS={primary:'#1c145c',accent:'#eab416'};
function doGet(){return json_({ok:true,service:'UPH Danlí - Notificaciones de aulas'});}
function doPost(e){try{const p=JSON.parse(e.postData.contents||'{}');if(p.action!=='sendRoom')throw new Error('Acción no válida');if(!p.to||!p.room)throw new Error('Faltan correo o aula');const updated=Boolean(p.previousRoom&&p.previousRoom!==p.room);const title=updated?'Actualización de aula asignada':'Aula asignada';const subject=`${updated?'ACTUALIZACIÓN · ':''}${p.code||''} ${p.subject||''} · ${p.room}`;const html=`<div style="background:#f4f4f8;padding:28px;font-family:Arial,sans-serif;color:#25243a"><div style="max-width:620px;margin:auto;background:white;border-radius:14px;overflow:hidden;box-shadow:0 8px 28px #1c145c20"><div style="background:${COLORS.primary};padding:24px;color:white"><div style="color:${COLORS.accent};font-weight:bold;font-size:12px;letter-spacing:1.5px">UNIVERSIDAD POLITÉCNICA DE HONDURAS</div><h2 style="margin:8px 0 0">${title}</h2></div><div style="padding:26px"><p>Estimado(a) <b>${safe_(p.teacher)}</b>:</p><p>${updated?`Se ha actualizado el aula previamente asignada (${safe_(p.previousRoom)}).`:'Le informamos la asignación de aula para su clase.'}</p><table style="width:100%;border-collapse:collapse"><tr><td style="padding:9px;border-bottom:1px solid #eee"><b>Asignatura</b></td><td style="padding:9px;border-bottom:1px solid #eee">${safe_(p.subject)}</td></tr><tr><td style="padding:9px;border-bottom:1px solid #eee"><b>Día y hora</b></td><td style="padding:9px;border-bottom:1px solid #eee">${safe_(p.day)} · ${safe_(p.hours)}</td></tr><tr><td style="padding:9px;border-bottom:1px solid #eee"><b>Campus</b></td><td style="padding:9px;border-bottom:1px solid #eee">${safe_(p.campus)}</td></tr></table><div style="margin:22px 0;background:${COLORS.accent};color:${COLORS.primary};font-size:22px;font-weight:bold;text-align:center;padding:15px;border-radius:9px">${safe_(p.room)}</div><p style="color:#6d6b78;font-size:13px">Mensaje enviado por TICS Danlí · ${safe_(p.sender||'tics.danli@uph.edu.hn')}</p></div></div></div>`;GmailApp.sendEmail(p.to,subject,`Asignatura: ${p.subject}\nDía: ${p.day}\nHora: ${p.hours}\nAula: ${p.room}`,{htmlBody:html,name:'TICS Danlí'});return json_({ok:true});}catch(err){return json_({ok:false,error:String(err.message||err)});}}
function safe_(v){return String(v||'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));}
function json_(v){return ContentService.createTextOutput(JSON.stringify(v)).setMimeType(ContentService.MimeType.JSON);}
